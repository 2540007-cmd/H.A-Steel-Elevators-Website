{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ha-steel",
  "compatibility_date": "2026-09-11",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "PROJECTS_KV",
      "id": "51bfda1c3e8544b1b6286f7738394545"
    }
  ]
}
